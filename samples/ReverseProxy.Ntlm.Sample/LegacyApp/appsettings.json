{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ekdala-case-management",
    "Audience": "ekdala-building-permits",
    // DEVELOPMENT ONLY. Must match ModernApp's Jwt:SigningKey. Use a secret store (user-secrets, Key Vault, ...) for real deployments.
    "SigningKey": "dev-only-signing-key-change-me-0123456789abcdef",
    "LifetimeMinutes": 30,
    "CookieName": "access_token"
  },
  "Authorization": {
    // Windows group (name or SID) -> application role. A group can grant several roles.
    // In production these would be AD groups, e.g.:
    //   { "Group": "EKDALA\\SG-All-Employees",       "Role": "Employee" },
    //   { "Group": "EKDALA\\SG-Case-Officers",       "Role": "CaseOfficer" },
    //   { "Group": "EKDALA\\SG-Building-Permits",    "Role": "PermitOfficer" },
    //   { "Group": "EKDALA\\SG-Case-Management-Admin", "Role": "Admin" }
    // For the local demo, every Windows user gets the officer roles. Built-in groups use SIDs because their
    // names are localized (e.g. "BUILTIN\\Användare" on Swedish Windows).
    "RoleMappings": [
      { "Group": "S-1-5-32-545", "Role": "Employee" },      // BUILTIN\Users
      { "Group": "S-1-5-32-545", "Role": "CaseOfficer" },   // BUILTIN\Users
      { "Group": "S-1-5-32-545", "Role": "PermitOfficer" }, // BUILTIN\Users
      { "Group": "S-1-5-32-544", "Role": "Admin" }          // BUILTIN\Administrators (only when running elevated / UAC off)
    ]
  }
}
