<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Yarp.Sample.Ntlm.ModernApp</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ClientAppRoot>ClientApp\</ClientAppRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(ClientAppRoot)node_modules\**;$(ClientAppRoot)dist\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.31" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="$(ClientAppRoot)**" />
    <None Remove="$(ClientAppRoot)**" />
    <None Include="$(ClientAppRoot)**" Exclude="$(ClientAppRoot)node_modules\**;$(ClientAppRoot)dist\**" />
    <ClientAppSource Include="$(ClientAppRoot)src\**;$(ClientAppRoot)index.html;$(ClientAppRoot)package.json;$(ClientAppRoot)vite.config.js" />
  </ItemGroup>

  <!--
    Builds the React app into ClientApp/dist, which Program.cs serves at /app. Skipped with a message when
    Node.js isn't installed, so the rest of the repo builds without it.
    The output is kept out of wwwroot on purpose: Vite renames its files on every build, which the static
    web assets manifest doesn't cope with.
  -->
  <Target Name="BuildClientApp" BeforeTargets="Build" Inputs="@(ClientAppSource)" Outputs="$(ClientAppRoot)dist\index.html">
    <Exec Command="node --version" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="NodeExitCode" />
    </Exec>
    <Message Importance="high" Condition="'$(NodeExitCode)' != '0'"
             Text="ModernApp: Node.js was not found, so the React app was not built. Install Node.js from https://nodejs.org and rebuild." />
    <Exec WorkingDirectory="$(ClientAppRoot)" Command="npm install" Condition="'$(NodeExitCode)' == '0' And !Exists('$(ClientAppRoot)node_modules')" />
    <Exec WorkingDirectory="$(ClientAppRoot)" Command="npm run build" Condition="'$(NodeExitCode)' == '0'" />
  </Target>

  <Target Name="PublishClientApp" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_ClientAppDist Include="$(ClientAppRoot)dist\**" />
      <ResolvedFileToPublish Include="@(_ClientAppDist)" RelativePath="$(ClientAppRoot)dist\%(_ClientAppDist.RecursiveDir)%(_ClientAppDist.Filename)%(_ClientAppDist.Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
