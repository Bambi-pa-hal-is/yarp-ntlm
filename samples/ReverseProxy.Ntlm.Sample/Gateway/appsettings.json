{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    // Both apps share one URL space: an endpoint keeps its URL when it moves from the legacy app to the modern app.
    // To migrate an endpoint, implement it in ModernApp with the same URL and add a route to the "modern" cluster here.
    // Anything without a route still goes to the legacy app.
    "Routes": {
      // The React front end.
      "modern-spa": {
        "ClusterId": "modern",
        "Match": { "Path": "/app/{**catch-all}" }
      },
      // Migrated APIs.
      "permits-api": {
        "ClusterId": "modern",
        "Match": { "Path": "/api/permits/{**catch-all}" }
      },
      "permit-reports-api": {
        "ClusterId": "modern",
        "Match": { "Path": "/api/reports/permits" }
      },
      // Example of the next migration: once GET /api/cases is rebuilt in ModernApp, uncomment this.
      // "Methods" moves only the reads; POST/PUT to /api/cases would still go to the legacy app.
      // "cases-api": {
      //   "ClusterId": "modern",
      //   "Match": { "Path": "/api/cases/{**catch-all}", "Methods": [ "GET" ] }
      // },

      // Everything else, including /api/users/me (Windows sign-in) and the legacy pages.
      "legacy": {
        "ClusterId": "legacy",
        "Order": 1000,
        "Match": { "Path": "{**catch-all}" }
      }
    },
    "Clusters": {
      "legacy": {
        "Destinations": {
          "legacy": { "Address": "http://localhost:5101/" }
        }
      },
      "modern": {
        // Requests to this cluster get the JWT cookie moved into the Authorization header (see Program.cs).
        "Metadata": { "JwtCookie": "access_token" },
        "Destinations": {
          "modern": { "Address": "http://localhost:5102/" }
        }
      }
    }
  }
}
